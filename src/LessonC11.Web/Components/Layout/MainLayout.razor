@inherits LayoutComponentBase

@* The navigation stays outside the interactive lab page so navigation.js keeps its listeners. *@
<main class="wrap">
    <section id="application-lab" aria-label="Application navigation"><StudentNav /></section>
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
